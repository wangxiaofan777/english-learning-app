# 复制为 .env 或注入环境变量；全部留空即可零配置体验（Mock LLM + dev 微信登录）
SPRING_PROFILES_ACTIVE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lingo
DB_USER=lingo
DB_PASSWORD=lingo123

# OpenAI 兼容大模型（DeepSeek / GLM / Qwen / OpenAI 均可）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 微信小程序（留空时微信登录走 dev 兜底）
WX_APPID=
WX_SECRET=

# 安全：上线必须更换
JWT_SECRET=please-change-me-to-a-random-32-bytes-minimum-secret
ADMIN_TOKEN=dev-admin
