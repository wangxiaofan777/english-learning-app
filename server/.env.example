# 裸机运行后端（java -jar / mvn spring-boot:run）时注入；Docker 部署改用根目录 .env
# 本地零配置体验：SPRING_PROFILES_ACTIVE=h2（内存库，自动放宽 dev 开关）
SPRING_PROFILES_ACTIVE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lingo
DB_USER=lingo
DB_PASSWORD=

# OpenAI 兼容大模型（DashScope / DeepSeek / GLM / Qwen / OpenAI 均可）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-flash

# 微信小程序（未配置且 WX_DEV_FALLBACK=false 时微信登录不可用）
WX_APPID=
WX_SECRET=
WX_DEV_FALLBACK=false

# 安全：必须提供（JWT_SECRET ≥32 字节；缺失时启动失败）
JWT_SECRET=
ADMIN_TOKEN=
GUEST_ENABLED=true
CORS_ALLOWED_ORIGINS=
