# 复制为 .env（根目录，docker compose 自动读取）并填入真实值
# —— 标注 [必填] 的项缺失时 compose 会 fail-fast，不会带默认凭据启动 ——

# 数据库密码 [必填]（openssl rand -base64 18 生成；已有旧数据卷时见 README「修改数据库密码」）
DB_PASSWORD=

# OpenAI 兼容大模型 [必填]（DashScope / DeepSeek / GLM / OpenAI 均可）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-flash

# 安全密钥 [必填]（JWT_SECRET 至少 32 字节：openssl rand -hex 32）
JWT_SECRET=
# 运营台口令 [必填]（openssl rand -hex 16，切勿使用 dev-admin）
ADMIN_TOKEN=

# 产品开关
GUEST_ENABLED=true              # 游客登录开关，不需要游客体验时设为 false
WX_DEV_FALLBACK=false           # 微信 dev 兜底，生产必须 false
WX_APPID=                       # 微信小程序 appid（微信登录必需）
WX_SECRET=                      # 微信小程序 secret

# 跨域白名单（逗号分隔）；H5 走同源 nginx 时可留空
CORS_ALLOWED_ORIGINS=
